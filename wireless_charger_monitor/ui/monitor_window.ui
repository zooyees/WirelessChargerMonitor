<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MonitorWindow</class>
 <widget class="QMainWindow" name="MonitorWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1600</width><height>950</height></rect>
  </property>
  <property name="windowTitle"><string>WiParse</string></property>
  <property name="styleSheet"><string>QMainWindow, QWidget#centralwidget {
    background-color: #0B1220;
    color: #FFFFFF;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
}
QLabel#main_title {
    font-size: 11pt;
    font-weight: bold;
    color: #FFFFFF;
    padding: 4px 2px;
    background-color: #111827;
    border-radius: 4px;
}
QGroupBox {
    font-weight: bold;
    color: #FFFFFF;
    background-color: #162032;
    border: 1px solid #8BA3BD;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px 5px 5px 5px;
    font-size: 10pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #FFFFFF;
}
QFrame#log_panel, QFrame#chart_panel {
    background-color: #162032;
    border-radius: 12px;
}
QWidget#chart_lcd_content {
    background-color: #162032;
    color: #FFFFFF;
}
QScrollArea#chart_lcd_scroll {
    background-color: #162032;
    border: none;
}
QFrame#log_control_panel {
    background-color: #162032;
    border: none;
}
QScrollBar:vertical {
    background: #162032;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #8BA3BD;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QLabel#data_label {
    color: #FFFFFF;
    background-color: transparent;
    font-size: 10pt;
    font-weight: 700;
    padding: 2px 0;
}
QLCDNumber {
    background-color: #070B14;
    color: #FFFFFF;
    border: 1px solid #C7D2E0;
    border-radius: 4px;
}
QComboBox {
    background-color: #243049;
    border: 1px solid #8BA3BD;
    border-radius: 4px;
    color: #FFFFFF;
    padding: 2px 6px;
    min-height: 25px;
    font-size: 10pt;
}
QComboBox QAbstractItemView {
    background-color: #243049;
    color: #FFFFFF;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}
QComboBox:editable {
    background-color: #243049;
}
QComboBox QLineEdit {
    background-color: #243049;
    color: #FFFFFF;
    border: none;
    border-radius: 0;
    padding: 0 2px;
    min-height: 0;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}
QLineEdit {
    background-color: #243049;
    border: 1px solid #8BA3BD;
    border-radius: 4px;
    color: #FFFFFF;
    padding: 4px 6px;
    min-height: 22px;
    font-size: 9pt;
}
QLineEdit:focus {
    border: 1px solid #38BDF8;
}
QPushButton {
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    font-weight: bold;
    border-radius: 5px;
    padding: 4px 10px;
    color: #FFFFFF;
    border: none;
    font-size: 10pt;
    background-color: #3D526E;
}
QPushButton#btn_start {
    background-color: #0284C7;
    color: #FFFFFF;
    padding: 3px 10px;
    min-height: 0;
}
QPushButton#btn_stop {
    background-color: #475569;
    color: #FFFFFF;
}
QPushButton#btn_stop:disabled {
    background-color: #334155;
    color: #CBD5E1;
}
QPushButton#btn_log_tool {
    background-color: #3D526E;
    border: 1px solid #8BA3BD;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 9pt;
    font-weight: 500;
    color: #F1F5F9;
    min-height: 0;
}
QPushButton#btn_log_tool:hover {
    background-color: #52657A;
    color: #FFFFFF;
}
QPushButton:hover {
    background-color: #52657A;
}
QPushButton#btn_start:hover {
    background-color: #0369A1;
}
QPlainTextEdit {
    background-color: #1A2332;
    color: #FFFFFF;
    border: 1px solid #8BA3BD;
    border-radius: 6px;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 10pt;
    padding: 6px;
    selection-background-color: #0369A1;
    selection-color: #FFFFFF;
}
QToolTip {
    color: #FFFFFF;
    background-color: #1E293B;
    border: 1px solid #38BDF8;
    border-radius: 6px;
    padding: 10px;
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif;
    font-size: 10pt;
}

QFrame#chart_panel, QFrame#log_panel {
    border: none;
}
QWidget#chart_container {
    background-color: #0B1220;
    min-height: 480px;
}
QLabel#chart_placeholder {
    color: #CBD5E1;
    font-size: 10pt;
    padding: 24px;
    background-color: transparent;
}
QLCDNumber#lcd_v_in { background-color: #070B14; color: #FFEB3B; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_i_in { background-color: #070B14; color: #69F0AE; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_v_out { background-color: #070B14; color: #FFEB3B; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_i_out { background-color: #070B14; color: #69F0AE; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_power { background-color: #070B14; color: #EA80FC; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_v_bat { background-color: #070B14; color: #FFEB3B; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_i_bat { background-color: #070B14; color: #69F0AE; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_temp { background-color: #070B14; color: #FFB74D; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }
QLCDNumber#lcd_battery { background-color: #070B14; color: #64FFDA; border: 1px solid #C7D2E0; border-radius: 4px; min-height: 32px; max-height: 36px; }</string></property>
