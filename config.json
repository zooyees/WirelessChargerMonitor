{
  "system": {
    "db_name": "charging_data.db",
    "log_file": "monitor.log",
    "log_level": "INFO",
    "db_commit_interval_sec": 1.0,
    "db_commit_batch_size": 100
  },
  "ui": {
    "render_interval_ms": 100,
    "chart_max_points": 500,
    "default_window_size_sec": 60.0,
    "language": "en",
    "menu_bar_auto_hide": false,
    "theme": "light"
  },
  "alerts": {
    "temp_warning_threshold": 60,
    "temp_recovery_threshold": 55,
    "ovp_threshold": 25.0,
    "ocp_threshold": 3.0,
    "full_charge_debounce_sec": 20.0
  },
  "charge_state": {
    "window_samples": 40,
    "min_samples": 20,
    "state_hold_sec": 4.0,
    "idle_i_max": 0.1,
    "trickle_i_max": 0.18,
    "cc_i_min": 0.12,
    "cc_dv_min": 0.025,
    "cv_v_std_max": 0.03,
    "cv_di_max": -0.025
  },
  "serial": {
    "default_baudrates": [
      "115200",
      "1000000",
      "2000000"
    ],
    "demo_mode": false,
    "auto_reconnect": true,
    "reconnect_interval_sec": 3.0,
    "max_reconnect_attempts": 5
  },
  "log_monitor": {
    "default_filename": "Live Packet Log",
    "save_dir": "logs",
    "file_extension": "txt"
  }
}